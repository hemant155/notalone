# Server
PORT=3000
# Public URL of this server — used to build the /a/:id tracking link sent in SMS/push.
# In production set this to your real domain, e.g. https://guardian.example.com
BASE_URL=http://localhost:3000

# SQLite file location
DB_FILE=./data/guardian.db

# SMS provider: "mock" (prints to console, good for dev) or "msg91" (real API)
SMS_PROVIDER=mock

# Only needed when SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# MSG91 route: 4 = transactional (default for alerts)
MSG91_ROUTE=4
